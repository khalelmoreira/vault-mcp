# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node (Claude Code CLI installs into the devcontainer's global npm, but just in case)
node_modules/

# Editor / OS noise
.DS_Store

# API keys for web/backend — never committed
.env

# Personal Claude Code permission overrides, not shared with the team
.claude/settings.local.json

# Vaults are the whole point of this project (real project memory for every
# project registered against this server). Ignore content by default, keep
# this repo's own example.md tracked as a sample of the format.
vaults/*/*.md
!vaults/project-vault-mcp/example.md
